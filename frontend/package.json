{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:visible": "PLAYWRIGHT_SLOW_MO=600 playwright test --headed --workers=1 --project=chromium",
    "demo:e2e": "PLAYWRIGHT_DEMO=1 PLAYWRIGHT_SLOW_MO=900 playwright test tests/claude-code-demo.spec.js --headed --workers=1 --project=chromium",
    "demo:bug": "PLAYWRIGHT_DEMO=1 PLAYWRIGHT_INCLUDE_DEMOS=1 PLAYWRIGHT_SLOW_MO=900 playwright test tests/visible-bug-failure.demo.spec.js --headed --workers=1 --project=chromium"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "jwt-decode": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5"
  }
}
